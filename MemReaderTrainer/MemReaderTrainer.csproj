<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>MemReaderTrainer</AssemblyName>
    <RootNamespace>MemReader</RootNamespace>
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    MainForm's "Build Trainer" step copies this whole project to a temp folder,
    overwrites GeneratedTargets.cs with the real process name and targets, and
    publishes it there - so GeneratedTargets.cs is the one file in this project
    that a build is expected to replace.
  -->

  <!-- Share the scanner core with the other two front ends rather than forking it. -->
  <ItemGroup>
    <Compile Include="..\MemReader\Native.cs" Link="Core\Native.cs" />
    <Compile Include="..\MemReader\ProcessMemory.cs" Link="Core\ProcessMemory.cs" />
    <Compile Include="..\MemReader\Scanner.cs" Link="Core\Scanner.cs" />
    <Compile Include="..\MemReader\PointerScanner.cs" Link="Core\PointerScanner.cs" />
    <Compile Include="..\MemReader\ChainFingerprint.cs" Link="Core\ChainFingerprint.cs" />
    <Compile Include="..\MemReaderGui\WatchEntry.cs" Link="Core\WatchEntry.cs" />
    <Compile Include="..\MemReaderGui\Theme.cs" Link="Core\Theme.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Iced" Version="1.21.0" />
  </ItemGroup>
</Project>
