# Build output - regenerated by `dotnet build`/`dotnet publish`, never source.
bin/
obj/
dist/

# Local crash logs and per-machine settings.
*.user
crash.log

# Pointer-chain exports are per-target and often per-machine; keep them local.
*.chains

# Staging area for `gh release create` - built exes belong in release assets,
# never in git history.
release/
